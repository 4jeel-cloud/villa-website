# Server
PORT=4000

# Admin token — protects /admin/* API routes
# Set a strong random string. Frontend must set VITE_ADMIN_TOKEN to the same value.
ADMIN_TOKEN=change-me-to-a-strong-secret
# Comma-separated list of Firebase user emails allowed admin access
# If empty, any valid Firebase token is accepted (less secure)
ADMIN_EMAILS=admin@example.com

# Google Apps Script Web App URL
# Your deployed web app that handles sheet read/write operations.
# The Node.js backend calls this for all data persistence.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Email (Brevo)
# Get API key from https://app.brevo.com/settings/keys/api
# Free tier: 300 emails/day, no domain needed
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxx
# Comma-separated list of emails to notify on new bookings
MANAGER_EMAIL=manager@example.com,manager2@example.com

# Razorpay (for online payments)
# Get keys from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Firestore Service Account (optional — if set, data persists in Firestore)
# Get this from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Paste the entire JSON as a single line (or use a credential file via GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Render ping (keep-awake)
# Your Render backend URL (e.g. https://your-app.onrender.com)
# Set this as a GitHub secret named RENDER_URL for the keep-awake cron
RENDER_URL=https://your-app.onrender.com
