# Server
PORT=4000

# Admin token — protects /admin/* API routes
# Set a strong random string. Frontend must set VITE_ADMIN_TOKEN to the same value.
ADMIN_TOKEN=change-me-to-a-strong-secret

# Google Apps Script Web App URL
# Your deployed web app that handles sheet read/write operations.
# The Node.js backend calls this for all data persistence.
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Email (Nodemailer via Gmail SMTP)
# Enable 2FA on Gmail → generate App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
MANAGER_EMAIL=manager@example.com

# Razorpay (for online payments)
# Get keys from Razorpay Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
